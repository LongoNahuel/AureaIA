__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
dist/

data/*.sqlite3
data/*.sqlite3.bak*
# Archivos hermanos del modo WAL (models/db.py): viven junto a la base
# y no los cubre el patron de arriba.
data/*.sqlite3-wal
data/*.sqlite3-shm
data/clips/*
data/snapshots/*
data/media/*
!data/clips/.gitkeep
!data/snapshots/.gitkeep
!data/media/.gitkeep
data/preferences.json
# Clave de cifrado de las credenciales de camara (core/credential_store.py).
# Commitearla convertiria el cifrado en decoracion: cualquiera con el repo
# podria descifrar la base de cualquier instalacion.
data/camera_key
# Backups previos a migrar y lock entre procesos (migrations/resguardo.py).
# Los backups llevan la base entera y una copia de camera_key: mismo motivo.
data/backups/
data/migracion.lock
*.log

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.jpg
*.png
*.mp4
# Los assets de la UI (logo, fondos, videos de marca) SI se versionan --
# sin esta excepcion los patrones globales de arriba se los comen y un
# clon fresco pierde el branding.
!aurea_vms/ui/assets/**
.claude/

# Rig de demo: binario (se baja de github, ver tools/demo/README.md) y
# certificado autofirmado que mediamtx genera al arrancar.
tools/demo/mediamtx
tools/demo/mediamtx.exe
# Clips que publican las camaras falsas (pesados, cada uno trae los suyos).
tools/demo/media/
auto.crt
auto.key

*.zip